# Example environment for ia-reviver.
#
# Source it directly for a shell session:
#   set -a; . ./.env.example; set +a
#
# On NixOS, prefer a file like this as a systemd EnvironmentFile, with the real
# password injected from a secret store:
#   EnvironmentFile = "/run/secrets/ia-reviver.env";

# --- qBittorrent WebUI -------------------------------------------------------

IA_REVIVER_QB_URL=http://127.0.0.1:8080

# Leave both unset if the WebUI "bypass authentication for localhost" option is
# enabled. Otherwise set the username and point at a password *file* rather than
# putting the password in the environment, where any process can read it from
# /proc/<pid>/environ.
IA_REVIVER_QB_USERNAME=admin
IA_REVIVER_QB_PASSWORD_FILE=/run/secrets/qbittorrent_password

# Only for a WebUI with a self-signed certificate.
# IA_REVIVER_INSECURE=true

# --- fetching ---------------------------------------------------------------

IA_REVIVER_JOBS=3
# IA_REVIVER_LIMIT_RATE=8M
IA_REVIVER_VERIFY=true

# --- behaviour --------------------------------------------------------------

# IA_REVIVER_STATE_DIR=/var/lib/ia-reviver
# IA_REVIVER_ARCHIVE_BASE_URL=https://archive.org
